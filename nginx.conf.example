# Skedz PWA - nginx Configuration Example
# 
# This configuration includes security headers, CSP, and optimal caching
# for production deployment of the Skedz PWA.
#
# Installation:
# 1. Copy to /etc/nginx/sites-available/skedz.conf
# 2. Adjust server_name and paths
# 3. Obtain SSL certificate (Let's Encrypt recommended)
# 4. Test: sudo nginx -t
# 5. Enable: sudo ln -s /etc/nginx/sites-available/skedz.conf /etc/nginx/sites-enabled/
# 6. Reload: sudo systemctl reload nginx

server {
    listen 80;
    server_name app.skedz.org;
    
    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name app.skedz.org;
    
    # =====================================================
    # SSL Configuration
    # =====================================================
    
    # Let's Encrypt SSL certificates
    ssl_certificate /etc/letsencrypt/live/app.skedz.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.skedz.org/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/app.skedz.org/chain.pem;
    
    # SSL protocols and ciphers (Mozilla Intermediate configuration)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    
    # SSL session cache
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    
    # OCSP stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;
    
    # =====================================================
    # Security Headers
    # =====================================================
    
    # Content Security Policy
    # Adjust connect-src domains based on your schedule sources
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://*.ccc.de https://*.congress.org https://*.skedz.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;" always;
    
    # Prevent clickjacking
    add_header X-Frame-Options "DENY" always;
    
    # Prevent MIME type sniffing
    add_header X-Content-Type-Options "nosniff" always;
    
    # Referrer policy (don't leak URLs to external sites)
    add_header Referrer-Policy "no-referrer" always;
    
    # Permissions policy (disable unused browser features)
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;
    
    # Cross-Origin policies
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    
    # HSTS (HTTP Strict Transport Security)
    # Tells browsers to always use HTTPS for this domain
    # WARNING: Only enable after testing HTTPS works correctly!
    # Once enabled, can't easily be undone (preload list is permanent)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    
    # Hide nginx version
    server_tokens off;
    
    # =====================================================
    # Document Root
    # =====================================================
    
    root /var/www/skedz/dist;
    index index.html;
    
    # =====================================================
    # Routing Configuration
    # =====================================================
    
    # SPA routing - serve index.html for all routes
    location / {
        try_files $uri $uri/ /index.html;
    }
    
    # Security: Prevent access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # =====================================================
    # Static Assets Caching
    # =====================================================
    
    # Static assets (1 week cache - SW handles updates)
    # Example: main.abc123.js, styles.def456.css
    location ~* \.(js|css|woff|woff2)$ {
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
        
        # Re-add security headers (add_header in nested location overrides parent)
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    
    # Images and other media
    location ~* \.(png|jpg|jpeg|gif|ico|svg|webp)$ {
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
        
        # Re-add critical security headers
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    
    # =====================================================
    # PWA Special Files
    # =====================================================
    
    # Service Worker - NEVER cache
    # Browser needs latest version to detect updates
    location = /sw.js {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate, proxy-revalidate" always;
        add_header Pragma "no-cache" always;
        
        # Re-add security headers
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Type "application/javascript; charset=utf-8" always;
    }
    
    # Manifest - cache but revalidate
    location = /manifest.webmanifest {
        expires 1d;
        add_header Cache-Control "public, must-revalidate" always;
        
        # Re-add security headers
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Type "application/manifest+json; charset=utf-8" always;
    }
    
    # Robots.txt
    location = /robots.txt {
        expires 1d;
        add_header Cache-Control "public";
        access_log off;
    }
    
    # =====================================================
    # Logging
    # =====================================================
    
    access_log /var/log/nginx/skedz_access.log;
    error_log /var/log/nginx/skedz_error.log warn;
    
    # =====================================================
    # Gzip Compression
    # =====================================================
    
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss application/rss+xml application/atom+xml image/svg+xml text/x-component;
    
    # Don't gzip if already compressed (br = brotli)
    gzip_disable "msie6";
    
    # =====================================================
    # Brotli Compression (if module installed)
    # =====================================================
    
    # brotli on;
    # brotli_comp_level 6;
    # brotli_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss application/rss+xml application/atom+xml image/svg+xml text/x-component;
}

# =====================================================
# Rate Limiting Configuration (Optional)
# =====================================================
# 
# Uncomment to enable rate limiting
# Add this BEFORE the server block:

# limit_req_zone $binary_remote_addr zone=skedz_limit:10m rate=10r/s;
# 
# Then add inside location / block:
# limit_req zone=skedz_limit burst=20 nodelay;
