# Copy this file to `.env` to customize build-time settings.
# All flags default to enabled ("true") when unset.

# Allow `?url=...&title=...` to override the imported schedule's title.
VITE_ENABLE_IMPORT_TITLE_PARAM=true

# Allow `?url=...&start=...&end=...&timezone=Europe/Copenhagen` (or
# `startdate`/`enddate`) to cut off sessions outside a date range at import time.
VITE_ENABLE_IMPORT_DATERANGE_PARAM=true
